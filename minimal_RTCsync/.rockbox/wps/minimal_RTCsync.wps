# Theme: minimal_RTCsync
# Version 1.0
# Last Update: 05/15/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: Minimalist but modern theme. All pixel art is by me. The picture on the menu changes according to the time of day (changes at 6 AM, 12 PM, and 6 PM). 
# Code based on: BACKBONE and Pixel Computer by me! which are based on SNARTY by Simon Anden and BONES by Chuck Largo!
# Icons & viewers from my 1ST_GEN_REMIX theme with some small changes. Hold screen does not show album art.
# The San Francisco font is owned by Apple Inc. and this theme does not claim any ownership over the font.

## WPS File ##

#Hide The Status Bar
%wd

# Clear Backdrop
%V(0,0,-,-,-)%VB
%V(0,0,-,-,-)

# Preload Fonts
%Fl(5,14-SFProDisplay-Heavy.fnt)
%Fl(6,16-SFProText-SemiboldItalic.fnt)
%Fl(7,20-SFProText-Regular.fnt)
%Fl(8,20-SFProText-Bold.fnt)
%Fl(9,26-SFProText-Bold.fnt)

# Preload Images
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(PB,pb.bmp,0,0)
%xl(PBB,pb_back.bmp,0,0)
%xl(VB,vb.bmp,0,0)
%xl(VBB,vb_back.bmp,0,0)
%xl(rtc_album,rtc_album.bmp)
%xl(disk,disk.bmp,0,0)

# Show Main Display unless Hold Switch is on
%?mh<%Vd(mainDisplay)%Vd(holdScreen)|%Vd(mainDisplay)%Vd(playScreen)>

## Main Display ##

# Clear Screen
%Vl(mainDisplay,0,0,320,240,-)

# Play/Pause Icons
%Vl(mainDisplay,10,7,22,22,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Disk Icons
%Vl(mainDisplay,38,9,17,18,-)
%?lh<%t(0.5)%xd(disk);%t(0.5)|>

# Now Playing / Playlist Name
%Vl(mainDisplay,60,10,200,25,7)
%s%?pn<%?pS(20)<%acNow Playing|%ac%pn>|%acNow Playing>

# Battery
%Vl(mainDisplay,260,7,54,23,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(mainDisplay,5,36,310,2,-)
%dr(0,0,310,2)

# Playlist Number
%Vl(mainDisplay,8,40,72,20,6)
%pp of %pe

# Repeat Icon
%Vl(mainDisplay,260,41,25,22,-)
%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>

# Shuffle Icon
%Vl(mainDisplay,289,41,25,22,-)
%?ps<%xd(shuffle,1)|%xd(shuffle,2)>

# Volume Bar
%Vl(mainDisplay,45,188,230,8,-)
%pv(0,0,230,8,VBB,backdrop,VB)

# Volume Text
%Vl(mainDisplay,10,184,25,18,5)
%acVOL

# Volume Level
%Vl(mainDisplay,279,184,40,20,5)
%ac%pvdb

# Track Progress Bar
%Vl(mainDisplay,20,205,280,14,-)%Vf(-)%Vb(-)
%pb(0,0,-,14,PBB,backdrop,PB)

# Time Elapsed
%Vl(mainDisplay,20,220,50,20,7)
%al%pc

# Time Remaining
%Vl(mainDisplay,250,220,50,20,7)
%ar-%pr

# Play Screen Album Art
%Vl(playScreen,8,60,122,122,-)
%Cl(1,1,120,120,c,c)
%?C<%Cd|%xd(rtc_album)>
%dr(0,0,122,1)
%dr(0,121,122,1)
%dr(0,1,1,120)
%dr(121,1,1,120)

# Album
%Vl(playScreen,135,65,180,20,7)
%al%s%?id<%id>

# Track Title
%Vl(playScreen,135,88,180,26,9)
%al%s%?it<%s%it|%fn>

# Artist
%Vl(playScreen,135,120,180,20,8)
%al%s%?ia<%ia>

# File Info
%Vl(playScreen,135,145,170,15,5)
%al%s%fc | %fb kbps | %fk kHz

## Hold Screen ##

# Album
%Vl(holdScreen,10,75,300,20,7)
%ac%s%?id<%id>

# Track Title
%Vl(holdScreen,10,105,300,30,9)
%ac%s%?it<%s%it|%fn>

# Artist
%Vl(holdScreen,10,140,300,20,8)
%ac%s%?ia<%ia>

# Next track
#%Vl(holdScreen,5,157,310,20,2)
#%ac%?pE(20)<%?It<%ac%s%Sx(Next Track:) %It|>|>